<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Test Suite" parallel="methods" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.automation.reporting.ExtentReportManager"/>
    </listeners>

    <test name="Smoke Tests">
        <classes>
            <class name="com.automation.testcases.SampleTest"/>
        </classes>
    </test>

    <test name="Regression Tests">
        <classes>
            <class name="com.automation.testcases.LoginTest"/>
        </classes>
    </test>

</suite>
